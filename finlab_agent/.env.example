FINLAB_DATA_BACKEND=sample
FINLAB_MODEL_BACKEND=demo
FINLAB_SAMPLE_PRICES=tests/fixtures/prices.csv
FINLAB_SAMPLE_FACTORS=tests/fixtures/factors.csv
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
